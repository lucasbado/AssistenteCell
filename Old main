# ESQUEMA DE ENTRADA (O que o Android manda)
class EventoCreate(BaseModel):
    categoria: str          # "MEDIA", "NOTIFICACAO", "APP_FOREGROUND", "SISTEMA"
    pacote_app: Optional[str] = None
    conteudo: dict[str, Any] # O Android já entrega o par chave-valor mapeado


async def agente_memoria_sqlite(evento: EventoCanonico):
    """Agente que escuta tudo e grava no banco de dados para a posteridade."""
    db = SessionLocal()
    try:
        novo_registro = EventoDB(
            id=evento.id_evento,
            timestamp=evento.timestamp,
            categoria=evento.categoria,
            pacote=evento.pacote_origem,
            conteudo_json=json.dumps(evento.conteudo, ensure_ascii=False),
        )
        db.add(novo_registro)
        db.commit()
        print(f"💾 [Memória] Evento {evento.id_evento[:8]} arquivado com sucesso.")
    except Exception as e:
        db.rollback()
        print(f"❌ [Memória] Erro ao gravar: {e}")
    finally:
        db.close()


class EventBus:
    def __init__(self):
        self._inscritos: dict[str, list[Callable[[EventoCanonico], Awaitable[None]]]] = {}
        self._fila = asyncio.Queue()

    def inscrever(self, topico: str, callback: Callable[[EventoCanonico], Awaitable[None]]):
        if topico not in self._inscritos:
            self._inscritos[topico] = []
        self._inscritos[topico].append(callback)
        print(f"🔗 Novo listener inscrito em: [{topico}]")

    async def publicar(self, evento: EventoCanonico):
        await self._fila.put(evento)
        print(f"📥 Evento {evento.id_evento[:8]}... [{evento.categoria}] publicado no barramento.")

    async def iniciar_processamento(self):
        print("⚙️ Motor do Event Bus iniciado.")
        while True:
            evento: EventoCanonico = await self._fila.get()
            
            # 1. ROTEAMENTO POR CATEGORIA (Ex: "MEDIA", "NOTIFICACAO")
            if evento.categoria in self._inscritos:
                for callback in self._inscritos[evento.categoria]:
                    asyncio.create_task(callback(evento))
            
            # 2. ROTEAMENTO POR PACOTE ESPECÍFICO (Para automações cirúrgicas)
            if evento.pacote_origem in self._inscritos:
                for callback in self._inscritos[evento.pacote_origem]:
                    asyncio.create_task(callback(evento))
            
            # 3. ROTEAMENTO GLOBAL (Arquivistas como o SQLite)
            if "*" in self._inscritos:
                for callback in self._inscritos["*"]:
                    asyncio.create_task(callback(evento))
            
            self._fila.task_done()

barramento = EventBus()


class MotorDeAtencao:
    def __init__(self):
        # Memória de curto prazo (Guarda o "O quê" e o "Quando")
        self.historico_assinaturas = {}
        self.janela_temporal_app = {}

        # Lixo que não entra no barramento de jeito nenhum
        self.blacklist = [
            "android",
            "com.android.systemui",
            "sistema_interno",
            "com.android.providers.downloads",
        ]

    def aprovar_evento(self, evento: EventoCanonico) -> bool:
        pacote = evento.pacote_origem.lower()

        # 1. FILTRO DE LIXO ABSOLUTO
        if pacote in self.blacklist or pacote == "sistema":
            return False

        # 2. DEDUPLICAÇÃO EXATA (O fim do Loop Infinito)
        # Cria uma impressão digital única para este evento
        conteudo_str = str(evento.conteudo.get("texto_bruto", ""))
        assinatura = f"{pacote}__{conteudo_str}"
        agora = time.time()

        if assinatura in self.historico_assinaturas:
            tempo_passado = agora - self.historico_assinaturas[assinatura]
            if tempo_passado < 45:  # Mesma coisa em menos de 45s? Silencia.
                print(f"🛑 [Atenção] Evento deduplicado (eco): {pacote}")
                return False

        # 3. CONTROLE DE FLUXO (Throttling de Mídia)
        # O Spotify envia dezenas de eventos por minuto atualizando tempo de música
        if "spotify" in pacote or "youtube" in pacote:
            if pacote in self.janela_temporal_app:
                tempo_passado = agora - self.janela_temporal_app[pacote]
                if (
                    tempo_passado < 15
                ):  # Exige 15 segundos de silêncio do app entre atualizações
                    print(f"🛑 [Atenção] Fluxo bloqueado (spam de mídia): {pacote}")
                    return False

        # 4. APROVAÇÃO
        # Se passou por tudo, grava na memória de curto prazo e deixa entrar
        self.historico_assinaturas[assinatura] = agora
        self.janela_temporal_app[pacote] = agora
        return True


# Instanciamos o nosso "Porteiro"
modulo_atencao = MotorDeAtencao()


