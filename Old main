# 3. O CÉREBRO (Integração com Ollama)
# ==========================================
async def agente_raciocinio_ollama(evento: EventoCanonico):
    print(f"🧠 [Raciocínio] A pensar sobre o evento de: {evento.pacote_origem}")

    conteudo_str = evento.conteudo.get("texto_bruto", "")

    system_prompt = """Você é a Ollie, assistente pessoal rodando no PC do usuário.
Analise a notificação ou evento de tela e decida se deve interagir.
Responda APENAS em JSON estrito.
Esquema: {"acao_necessaria": boolean, "mensagem_dinamica": "string" | null}
Regra: Aja de forma natural, amigável e curta. Não repita informações óbvias, adicione personalidade."""

    payload = {
        "model": "qwen2.5:7b",
        "prompt": f"App: {evento.pacote_origem} | Conteúdo: {conteudo_str}",
        "system": system_prompt,
        "stream": False,
        "format": "json",
        "options": {"num_ctx": 1024, "temperature": 0.3},
    }

    try:
        # Como o requests.post trava (é síncrono), rodamos numa thread separada
        # para não congelar o EventBus enquanto a IA pensa.
        loop = asyncio.get_running_loop()
        response = await loop.run_in_executor(
            None,
            lambda: requests.post(
                "http://localhost:11434/api/generate", json=payload, timeout=15
            ),
        )

        dados_ia = json.loads(response.json().get("response", "{}"))

        if dados_ia.get("acao_necessaria") and dados_ia.get("mensagem_dinamica"):
            mensagem = dados_ia["mensagem_dinamica"]
            print(f"🎯 [Raciocínio] Decisão tomada: Enviar notificação -> {mensagem}")

            # Chama o WebSocket diretamente para alertar o celular
            await central_alertas.alertar_celular(titulo="Ollie", texto=mensagem)
        else:
            print("😴 [Raciocínio] Nenhuma ação necessária para este evento.")

    except Exception as e:
        print(f"❌ [Raciocínio] Falha na inferência: {e}")


