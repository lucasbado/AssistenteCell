@app.post("/eventos", status_code=status.HTTP_202_ACCEPTED)
async def receber_evento(evento: EventoCreate):
    pacote = evento.pacote_app.lower() if evento.pacote_app else "sistema"
    categoria_padrao = evento.categoria.upper()

    # Monta o contrato canônico
    evento_canonico = EventoCanonico(
        categoria=categoria_padrao,
        pacote=pacote,
        payload=evento.conteudo
    )

    # O Módulo de Atenção avalia se deixa passar (Aplica Throttling e Deduplicação)
    # *Nota: Dentro do seu MotorDeAtencao, lembre-se de adaptar a leitura 
    # para usar `evento.categoria` e `evento.conteudo` estruturado.*
    if not modulo_atencao.aprovar_evento(evento_canonico):
        return {"status": "ignorado_pela_atencao"}

    await barramento.publicar(evento_canonico)

    return {
        "sucesso": True, 
        "id_evento": evento_canonico.id_evento, 
        "status": "evento_publicado"
    }
