class GerenciadorNotificacoes:
    def __init__(self):
        self.conexoes_ativas: list[WebSocket] = []

    async def conectar(self, websocket: WebSocket):
        await websocket.accept()  # O ÚNICO ACCEPT DEVE FICAR AQUI
        self.conexoes_ativas.append(websocket)
        print("✅ Conexão WS salva no Gerenciador!")

    def desconectar(self, websocket: WebSocket):
        if websocket in self.conexoes_ativas:
            self.conexoes_ativas.remove(websocket)

    async def alertar_celular(self, titulo: str, texto: str):
        print(
            f"📡 [RADAR] Tentando enviar alerta. Conexões ativas no WS: {len(self.conexoes_ativas)}"
        )

        if not self.conexoes_ativas:
            print(
                "⚠️ [ALERTA] O celular mandou o evento HTTP, mas o WebSocket estava desconectado!"
            )

        for conexao in self.conexoes_ativas:
            try:
                # Adicionamos um campo "origem": "Assistente"
                await conexao.send_json(
                    {"titulo": titulo, "texto": texto, "origem_sistema": "Assistente"}
                )
            except Exception as e:
                print(f"❌ Erro: {e}")


central_alertas = GerenciadorNotificacoes()


# O FastAPI precisa iniciar a fila do Barramento junto com o servidor
@asynccontextmanager
async def lifespan(app: FastAPI):
    # Roda antes do servidor começar a aceitar conexões
    task_barramento = asyncio.create_task(barramento.iniciar_processamento())
    yield
    # Roda quando o servidor é desligado
    task_barramento.cancel()


app = FastAPI(lifespan=lifespan)


